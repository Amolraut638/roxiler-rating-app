# Environment Variables

# The port the HTTP server will listen on
PORT=

# PostgreSQL connection string (Prisma DATABASE_URL format)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Secret key used to sign/verify JWT tokens (min 32 characters recommended)
JWT_SECRET=

# JWT token lifetime (e.g. 1d, 7d, 2h)
JWT_EXPIRES_IN=1d
